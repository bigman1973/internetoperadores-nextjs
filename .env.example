# Base de datos
DATABASE_URL="postgresql://usuario:password@host:port/database"

# NextAuth
NEXTAUTH_URL="https://www.internetoperadores.com"
NEXTAUTH_SECRET="tu_secret_super_seguro_aqui"

# Azure AD (Microsoft) Authentication
AZURE_AD_CLIENT_ID=your_client_id
AZURE_AD_CLIENT_SECRET=your_client_secret
AZURE_AD_TENANT_ID=your_tenant_id

# Microsoft Graph para correo CRM
# Permiso Application: Mail.Send con consentimiento de administrador.
EMAIL_FROM="buzon-corporativo@internetoperadores.com"

# Outlook individual para reuniones CRM
# Permisos Delegated: Calendars.ReadWrite y User.Read. Cada usuario conecta su propia cuenta corporativa.
# La clave dedicada es opcional; si se omite, se deriva de NEXTAUTH_SECRET con separación de dominio.
# Cambiar cualquiera de las claves invalida las conexiones cifradas existentes.
OUTLOOK_USER_CALENDAR_ENABLED="false"
# OUTLOOK_TOKEN_ENCRYPTION_KEY="genera_una_clave_aleatoria_de_al_menos_32_bytes"
# Definir por entorno: https://www.internetoperadores.com o https://staging.internetoperadores.com
OUTLOOK_USER_CALENDAR_PUBLIC_ORIGIN="https://www.internetoperadores.com"

# HubSpot CRM
HUBSPOT_API_KEY=pat-eu1-xxxx

# Vivid Business Acquiring (Pagos con tarjeta y SEPA)
VIVID_CLIENT_ID=your_vivid_client_id
VIVID_SECRET=your_vivid_secret

# Triple-A (Pagos con stablecoins USDC/EURC)
TRIPLE_A_CLIENT_ID=your_triple_a_client_id
TRIPLE_A_CLIENT_SECRET=your_triple_a_client_secret
TRIPLE_A_MERCHANT_KEY=your_triple_a_merchant_key

# Email (para notificaciones - opcional por ahora)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@internetoperadores.com"
SMTP_PASS="password"
SMTP_FROM="Internet Operadores <noreply@internetoperadores.com>"

# Asistente IA privado (valores seguros por defecto; no incluir secretos reales)
# Activación: en staging, si ASSISTANT_PUBLIC_ENABLED no está definida y
# FINANCE_STAGING_SANDBOX=1, se aplica la regla del contrato. En producción,
# público y modo local permanecen apagados hasta aprobación explícita.
# FINANCE_STAGING_SANDBOX="1"
# ASSISTANT_PUBLIC_ENABLED="false"
# ASSISTANT_CLIENT_ENABLED="false"
# ASSISTANT_MODE="desactivado" # extractivo | local | desactivado
# ASSISTANT_LOCAL_BASE_URL=""
# ASSISTANT_LOCAL_MODEL=""
# ASSISTANT_LOCAL_API_KEY=""
# ASSISTANT_EMBEDDINGS_URL=""
# ASSISTANT_EMBEDDINGS_API_KEY=""
# ASSISTANT_RERANK_ENABLED="false"
# ASSISTANT_MAX_MESSAGE_CHARS="1500"
# ASSISTANT_PUBLIC_RATE_LIMIT_PER_10M="20"
# ASSISTANT_HASH_SECRET="" # si falta, se deriva de NEXTAUTH_SECRET
# ASSISTANT_RETENTION_MONTHS="12"
# ASSISTANT_CONSENT_VERSION="2026-10-borrador"
# ASSISTANT_EMAIL_ENABLED="false"
# ASSISTANT_CRON_ENABLED="false"
# ASSISTANT_DAILY_REPORT_HOUR="8"
