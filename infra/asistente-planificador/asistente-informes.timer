# Plantilla: no está instalada ni habilitada por este repositorio.
[Unit]
Description=Ejecutar informes del asistente todos los días a las 08:00 Europe/Madrid (staging)

[Timer]
OnCalendar=*-*-* 08:00:00 Europe/Madrid
Persistent=true
AccuracySec=1min
Unit=asistente-informes.service

[Install]
WantedBy=timers.target
