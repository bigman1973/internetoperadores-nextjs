# Generado por instalar-offline.sh. Sólo para host dedicado al asistente.
# Sustituir __INGRESS_CIDRS__ y __ADMIN_SSH_CIDR__ por CIDR validados.
flush table inet io_asistente

table inet io_asistente {
  set relay_ingress {
    type ipv4_addr
    flags interval
    elements = { __INGRESS_CIDRS__ }
  }

  set admin_ssh {
    type ipv4_addr
    flags interval
    elements = { __ADMIN_SSH_CIDR__ }
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state established,related accept
    ip saddr @admin_ssh tcp dport 22 accept comment "Administración SSH desde red aprobada"
    # Añadir aquí explícitamente una red NTP interna si se aprueba; no hay DNS/HTTP saliente.
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    # Relay/VPN aprobado -> Caddy publicado en borde:8443 (NAT desde 443 del host).
    ip saddr @relay_ingress ip daddr 172.31.0.0/24 tcp dport 8443 accept
    # Caddy puede llegar sólo a las APIs internas necesarias.
    ip saddr 172.31.0.0/24 ip daddr 172.30.0.0/24 tcp dport { 8000, 8080 } accept
    # Comunicación entre servicios de la red interna Docker.
    ip saddr 172.30.0.0/24 ip daddr 172.30.0.0/24 accept
  }

  chain output {
    type filter hook output priority filter; policy drop;
    oif "lo" accept
    ct state established,related accept
    ip daddr 172.30.0.0/24 accept comment "Servicios internos"
    ip daddr 172.31.0.0/24 accept comment "Caddy en borde"
    # No se permite egress a Internet. Excepciones sólo con cambio aprobado y documentado.
  }
}
