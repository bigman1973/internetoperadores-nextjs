# Copiar como backup.env con permisos 600. Destino montado/cifrado localmente, nunca URL remota.
BACKUP_DESTINATION=/srv/io-asistente-backups
BACKUP_RETENTION_DAYS=30
# Archivo de destinatarios age públicos (puede residir en el host); se usa al cifrar.
BACKUP_AGE_RECIPIENTS_FILE=/etc/io-asistente/backup.age-recipients
# Identidad privada age custodiada fuera del host principal; se monta temporalmente sólo al restaurar.
BACKUP_AGE_IDENTITY_FILE=/mnt/recuperacion-segura/io-asistente-backup.agekey
