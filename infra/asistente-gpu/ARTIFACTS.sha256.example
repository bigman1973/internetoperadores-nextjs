# Formato compatible con `sha256sum -c`, relativo a offline-bundle/.
# Preparar y revisar por dos personas en la estación conectada.
# El instalador rechaza el marcador REEMPLAZAR.
REEMPLAZAR_SHA256  images/caddy.oci.tar
REEMPLAZAR_SHA256  images/asistente-rag.oci.tar
REEMPLAZAR_SHA256  images/vllm.oci.tar
