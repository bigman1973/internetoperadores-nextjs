# Ejemplo exclusivo del host GPU aislado. Copiar a .env, completar con secretos
# diferentes gestionados fuera de Git y aplicar chmod 600. El instalador rechaza
# cualquier valor CAMBIAR_. No usar claves reales, URLs públicas ni credenciales
# de otros entornos en este fichero de ejemplo.

# Borde Caddy: token adicional al certificado de cliente mTLS.
CADDY_GATEWAY_TOKEN=CAMBIAR_TOKEN_GATEWAY_ALEATORIO

# APIs internas. No reutilizar entre vLLM y FastAPI.
VLLM_INTERNAL_API_KEY=CAMBIAR_TOKEN_VLLM_ALEATORIO
ASSISTANT_RAG_API_KEY=CAMBIAR_TOKEN_RAG_ALEATORIO

# Modelos locales que ya deben existir en ./models, de sólo lectura.
ASSISTANT_RAG_BACKEND=real
ASSISTANT_EMBEDDINGS_MODEL=bge-m3
ASSISTANT_RERANK_MODEL=bge-reranker-v2-m3
ASSISTANT_SPACY_MODEL=es_core_news_lg
ASSISTANT_RERANK_ENABLED=false
VLLM_MODEL_PATH=/models/Qwen3-32B-AWQ
VLLM_SERVED_MODEL_NAME=io-qwen3-32b-awq

# Sólo se requieren al activar de forma aprobada el perfil observabilidad.
LANGFUSE_DB_PASSWORD=CAMBIAR_PASSWORD_LANGFUSE
LANGFUSE_NEXTAUTH_SECRET=CAMBIAR_SECRETO_LANGFUSE
LANGFUSE_SALT=CAMBIAR_SALT_LANGFUSE
MINIO_ROOT_USER=CAMBIAR_USUARIO_MINIO
MINIO_ROOT_PASSWORD=CAMBIAR_PASSWORD_MINIO
